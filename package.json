{
  "name": "flowops",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:studio": "npm run dev --workspace studio-web -- --hostname 127.0.0.1 --port 3000",
    "dev:portal": "npm run dev --workspace portal-web -- --hostname 127.0.0.1 --port 3001",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
